[gd_scene load_steps=2 format=3 uid="uid://team_scene"]

[ext_resource type="Script" path="res://scripts/ui/team_ui.gd" id="1_team"]

[node name="Team" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_team")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.04, 0.05, 0.1, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = -16.0
theme_override_constants/separation = 12

[node name="Header" type="Label" parent="VBox"]
layout_mode = 2
text = "Team Builder"
theme_override_font_sizes/font_size = 20

[node name="TeamPanel" type="PanelContainer" parent="VBox"]
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="VBox/TeamPanel"]
layout_mode = 2

[node name="TeamName" type="Label" parent="VBox/TeamPanel/VBox"]
layout_mode = 2
text = "Main Team"
name = "TeamName"

[node name="SlotsGrid" type="GridContainer" parent="VBox/TeamPanel/VBox"]
layout_mode = 2
columns = 3
name = "SlotsGrid"
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="HeroListLabel" type="Label" parent="VBox"]
layout_mode = 2
